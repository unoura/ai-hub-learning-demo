# このファイルを `.env` にコピーして値を設定してください(`.env` はコミットされません)。
#   cp .env.example .env
# 手順3(Wallet)で使用します。手順1では未設定でも起動できます。

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ホスト側の公開ポート(他コンテナと衝突する場合はここで変更)。
# コンテナ側は 1972 / 52773 固定。
HOST_SUPERSERVER_PORT=51972
HOST_WEB_PORT=51773
